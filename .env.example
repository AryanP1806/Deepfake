# Copy this file to ".env" (same folder as docker-compose.yml). Never commit .env. Keys are read at request time.
# Hive V3 is the PRIMARY detector: when it answers, its scores decide the verdict and the local detectors
# (SPAI / SBI / TruFor) are shown as the second opinion. Use the SECRET key as the Bearer token.
HIVE_SECRET_KEY=
# More keys, tried in order when the previous one is rejected, out of credit, rate-limited or down.
# Only when every key fails does the verdict fall back to the local detectors.
# HIVE_SECRET_KEY_2=
# HIVE_SECRET_KEY_3=
# (… up to HIVE_SECRET_KEY_20, or a comma-separated HIVE_SECRET_KEYS=k4,k5)
HIVE_ACCESS_KEY_ID=
# sf1 (default, api.thehive.ai) or va1 (api-va1.thehive.ai) — must match the region in your key's policy.
# A key in another region: HIVE_REGION_2=va1
HIVE_REGION=sf1
# 1 (default): media is sent to Hive automatically (logged in the custody chain). 0: ask for consent per case.
# HIVE_AUTO_UPLOAD=1
# Optional: override the V3 endpoint
# HIVE_V3_URL=https://api.thehive.ai/api/v3/hive/ai-generated-and-deepfake-content-detection
